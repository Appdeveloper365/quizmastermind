# 1. Copy this file to .env and fill in your key
# Get key: https://app.cline.bot > Settings > API Keys > Create API Key
# Same key works for ALL cline-pass/* models (ClinePass quota is shared).
CLINE_API_KEY=your_cline_api_key_here

# Workspace the agent works in (default: this folder)
WORKSPACE=.

# Auto-approve file writes without prompting (true = fully auto-run, false = ask via policy)
AUTO_APPROVE_WRITE=true

# --- Optional Tier 4 continuity (used only when every ClinePass model hits 402/429) ---
# Option A: Cline FREE promo model (separate free quota, $0) — same API base:
# CONTINUITY_PROVIDER=openai-compatible
# CONTINUITY_MODEL=minimax/minimax-m2.5
# CONTINUITY_BASE_URL=https://api.cline.bot/api/v1
# CONTINUITY_API_KEY=${CLINE_API_KEY}
# Option B: local Ollama (infinite, $0) — run `ollama pull qwen2.5-coder:32b` first:
# CONTINUITY_PROVIDER=ollama
# CONTINUITY_MODEL=qwen2.5-coder:32b
# CONTINUITY_BASE_URL=http://localhost:11434/v1
