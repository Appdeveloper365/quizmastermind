{
  "name": "quiz-mastermind",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Quiz Mastermind — Vite/TS quiz app with local Ollama support (no cloud/copilot required)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "node auto-cline.mjs",
    "ask": "node auto-cline.mjs --prompt",
    "local": "node auto-local.mjs",
    "local-ask": "node auto-local.mjs --prompt"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85"
  },
  "devDependencies": {
    "@cline/sdk": "^0.0.83",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
